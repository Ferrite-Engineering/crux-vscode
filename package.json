{
  "name": "crux-vscode",
  "private": true,
  "version": "0.0.0",
  "description": "EDACrux VSCode extension pack workspace — host-core + product surfaces",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "package": "pnpm -r run package",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.9"
  }
}
