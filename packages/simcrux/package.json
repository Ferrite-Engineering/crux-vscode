{
  "name": "simcrux",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "ferrite-engineering",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "homepage": "https://simcrux.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ferrite-Engineering/crux-vscode.git",
    "directory": "packages/simcrux"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1A2033",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "regression",
    "simulation",
    "rtl",
    "verilog",
    "systemverilog",
    "vhdl",
    "fpga",
    "asic",
    "verilator",
    "cocotb",
    "symbiyosys",
    "formal",
    "test-explorer",
    "verification"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%crux.untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "simcrux.refreshResults",
        "title": "%crux.command.simcrux.refresh.title%",
        "category": "%crux.command.category%"
      },
      {
        "command": "simcrux.runRegression",
        "title": "%crux.command.simcrux.runRegression.title%",
        "category": "%crux.command.category%"
      },
      {
        "command": "simcrux.openCounterexample",
        "title": "%crux.command.simcrux.openCounterexample.title%",
        "category": "%crux.command.category%"
      },
      {
        "command": "simcrux.openHistoryInDesktop",
        "title": "%crux.command.simcrux.history.title%",
        "category": "%crux.command.category%"
      },
      {
        "command": "edacrux.openCapabilitiesPanel",
        "title": "%crux.command.openCapabilitiesPanel.title%",
        "category": "%crux.command.category%"
      },
      {
        "command": "edacrux.sendSelectionToPeer",
        "title": "%crux.command.sendSelectionToPeer.title%",
        "category": "%crux.command.category%"
      },
      {
        "command": "edacrux.highlightSelectionInPeer",
        "title": "%crux.command.highlightSelectionInPeer.title%",
        "category": "%crux.command.category%"
      }
    ],
    "menus": {
      "testing/item/context": [
        {
          "command": "simcrux.openCounterexample",
          "group": "simcrux@1"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "simcrux",
        "required": [],
        "properties": {
          "config": {
            "type": "string",
            "description": "%crux.task.simcrux.config.description%"
          },
          "filter": {
            "type": "string",
            "description": "%crux.task.simcrux.filter.description%"
          }
        }
      }
    ],
    "configuration": {
      "title": "%crux.configuration.title%",
      "properties": {
        "edacrux.sim.projectFile": {
          "type": "string",
          "default": "simcrux.yaml",
          "markdownDescription": "%crux.configuration.sim.projectFile.description%"
        },
        "edacrux.sim.resultsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%crux.configuration.sim.resultsPath.description%"
        },
        "edacrux.sim.executable": {
          "type": "string",
          "default": "simcrux",
          "markdownDescription": "%crux.configuration.sim.executable.description%"
        },
        "edacrux.crossProbe.revealSelection": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%crux.configuration.crossProbe.revealSelection.description%"
        },
        "edacrux.crossProbe.openSourceFocusesEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%crux.configuration.crossProbe.openSourceFocusesEditor.description%"
        },
        "edacrux.crossProbe.followWaveformSelection": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%crux.configuration.crossProbe.followWaveformSelection.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node ../../tool/build-extension.mjs",
    "watch": "node ../../tool/build-extension.mjs --watch",
    "package": "mkdir -p dist && vsce package --no-dependencies --out ./dist/",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist coverage .vitest-cache"
  },
  "dependencies": {
    "@crux-vscode/host-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.90.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
