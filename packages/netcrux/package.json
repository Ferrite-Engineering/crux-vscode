{
  "name": "netcrux",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "ferrite-engineering",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "homepage": "https://netcrux.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ferrite-Engineering/crux-vscode.git",
    "directory": "packages/netcrux"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#252D3C",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "netlist",
    "schematic",
    "preview",
    "json",
    "rtl",
    "verilog",
    "systemverilog",
    "vhdl",
    "hdl",
    "fpga",
    "asic",
    "synthesis",
    "yosys",
    "cross-probe",
    "verification"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%crux.untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "netcrux.openSchematicPreview",
        "title": "%crux.command.netcrux.openSchematicPreview.title%",
        "category": "%crux.command.category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "netcrux.openInNetCrux",
        "title": "%crux.command.netcrux.openInNetCrux.title%",
        "category": "%crux.command.category%",
        "icon": "$(link-external)"
      },
      {
        "command": "netcrux.whatDrivesThis",
        "title": "%crux.command.netcrux.whatDrivesThis.title%",
        "category": "%crux.command.category%"
      },
      {
        "command": "edacrux.openCapabilitiesPanel",
        "title": "%crux.command.openCapabilitiesPanel.title%",
        "category": "%crux.command.category%"
      },
      {
        "command": "edacrux.sendSelectionToPeer",
        "title": "%crux.command.sendSelectionToPeer.title%",
        "category": "%crux.command.category%"
      },
      {
        "command": "edacrux.highlightSelectionInPeer",
        "title": "%crux.command.highlightSelectionInPeer.title%",
        "category": "%crux.command.category%"
      }
    ],
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ]
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ]
      },
      {
        "id": "vhdl",
        "aliases": [
          "VHDL"
        ],
        "extensions": [
          ".vhd",
          ".vhdl"
        ]
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "netcrux.whatDrivesThis",
          "when": "editorTextFocus && (resourceLangId == verilog || resourceLangId == systemverilog || resourceLangId == vhdl)",
          "group": "netcrux@1"
        },
        {
          "command": "netcrux.openSchematicPreview",
          "when": "netcrux.isYosysNetlist && resourceExtname == .json",
          "group": "netcrux@2"
        }
      ],
      "explorer/context": [
        {
          "command": "netcrux.openSchematicPreview",
          "when": "resourceExtname == .json",
          "group": "netcrux@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "netcrux.openSchematicPreview",
          "when": "resourceExtname == .json && activeCustomEditorId != netcrux.schematic",
          "group": "netcrux@1"
        },
        {
          "command": "netcrux.openInNetCrux",
          "when": "resourceExtname == .json",
          "group": "netcrux@2"
        }
      ],
      "editor/title": [
        {
          "command": "netcrux.openSchematicPreview",
          "when": "netcrux.isYosysNetlist && resourceExtname == .json",
          "group": "navigation@1"
        },
        {
          "command": "netcrux.openInNetCrux",
          "when": "activeCustomEditorId == netcrux.schematic",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "netcrux.openSchematicPreview",
          "when": "resourceExtname == .json || activeCustomEditorId == netcrux.schematic"
        },
        {
          "command": "netcrux.openInNetCrux",
          "when": "resourceExtname == .json || activeCustomEditorId == netcrux.schematic"
        }
      ]
    },
    "configuration": {
      "title": "%crux.configuration.title%",
      "properties": {
        "edacrux.crossProbe.revealSelection": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%crux.configuration.crossProbe.revealSelection.description%"
        },
        "edacrux.crossProbe.openSourceFocusesEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%crux.configuration.crossProbe.openSourceFocusesEditor.description%"
        },
        "netcrux.preview.maxFileSizeMB": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 256,
          "markdownDescription": "%crux.configuration.preview.maxFileSizeMB.description%"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "netcrux.schematic",
        "displayName": "%crux.editor.netcrux.schematic.displayName%",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "build": "node ../../tool/build-extension.mjs",
    "watch": "node ../../tool/build-extension.mjs --watch",
    "package": "node ../../tool/build-netcrux-web.mjs --check && mkdir -p dist && vsce package --no-dependencies --out ./dist/",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist coverage .vitest-cache",
    "build:web": "node ../../tool/build-netcrux-web.mjs"
  },
  "dependencies": {
    "@crux-vscode/host-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.90.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
